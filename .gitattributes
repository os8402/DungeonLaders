# 기본: Git 이 텍스트를 자동 판별하고, 저장소에는 LF 로 정규화한다.
* text=auto

# ── Unity YAML (씬/프리팹/에셋) ─────────────────────────────
# unityyamlmerge 를 붙여두면 씬·프리팹 충돌을 Unity SmartMerge 로 풀 수 있다.
# 설정: git config merge.unityyamlmerge.driver \
#         '"<Unity>/Editor/Data/Tools/UnityYAMLMerge.exe" merge -p %O %B %A %A'
*.unity            text eol=lf merge=unityyamlmerge
*.prefab           text eol=lf merge=unityyamlmerge
*.asset            text eol=lf merge=unityyamlmerge
*.mat              text eol=lf merge=unityyamlmerge
*.anim             text eol=lf merge=unityyamlmerge
*.controller       text eol=lf merge=unityyamlmerge
*.overrideControll text eol=lf merge=unityyamlmerge
*.physicMaterial   text eol=lf merge=unityyamlmerge
*.physicsMaterial2D text eol=lf merge=unityyamlmerge
*.meta             text eol=lf
*.shader           text eol=lf

# ── 소스 ───────────────────────────────────────────────────
*.cs               text eol=lf diff=csharp
*.json             text eol=lf
*.md               text eol=lf
*.proto            text eol=lf
*.csproj           text eol=crlf
*.sln              text eol=crlf

# ── 바이너리 (diff/정규화 금지) ────────────────────────────
*.png              binary
*.jpg              binary
*.psd              binary
*.gif              binary
*.ttf              binary
*.otf              binary
*.wav              binary
*.mp3              binary
*.ogg              binary
*.dll              binary
*.exe              binary
*.pdb              binary
*.unitypackage     binary
