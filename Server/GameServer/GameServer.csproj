<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>5</WarningLevel>
    <OutputPath>bin\Debug\Build\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.28.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerCore\ServerCore.csproj" />
    <ProjectReference Include="..\SharedDB\SharedDB.csproj" />
  </ItemGroup>






  <!--
    원본은 PreBuildEvent 에서 cmd `copy "$(TargetDir)" "bin\Debug\Elenia\Build"` 를 돌렸다.
      - 대상 폴더가 없으면(=클린 클론) copy 가 실패해 빌드 전체가 깨진다.
      - cmd copy 는 하위 폴더를 복사하지 못한다.
    MSBuild Copy 태스크로 교체: 폴더 자동 생성 + 재귀 복사 + 증분 복사.
    인스턴스별 config.json 은 Server/Configs/<이름>/ 에서 가져온다.
  -->
  <ItemGroup>
    <ServerInstance Include="Elenia" />
    <ServerInstance Include="Henesis" />
    <ServerInstance Include="Perion" />
    <ServerInstance Include="Kunning" />
  </ItemGroup>

  <Target Name="FanOutServerInstances" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="CopyToServerInstance"
             Properties="InstanceName=%(ServerInstance.Identity);Configuration=$(Configuration);Platform=$(Platform)" />
  </Target>

  <Target Name="CopyToServerInstance">
    <ItemGroup>
      <BuiltOutput Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(BuiltOutput)"
          DestinationFolder="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(InstanceName)\Build\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\Configs\$(InstanceName)\config.json"
          DestinationFolder="$(MSBuildProjectDirectory)\bin\$(Configuration)\$(InstanceName)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\..\Configs\$(InstanceName)\config.json')" />
  </Target>

</Project>
